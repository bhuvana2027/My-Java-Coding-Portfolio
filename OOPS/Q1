//Program to write explain different types of Inheritances using classes.

pckage Tasks;
  class Animal{  //parent class
     void eat() {
    	 System.out.println("Animals eat");
       }
     }
  // Single level inheritance
  class Dog extends Animal{   // Dog is been extended from Animal(parent class)
	  void bark() {
		  System.out.println("Dogs Bark");
	  }
    }
  // Multilevel inheritance 
  class puppy extends Dog{    // Puppy is been extended from Dog(child class)
	  void play() {
		  System.out.println("Puppy plays");
	  }
    }
  class Cat extends  Animal{   // cat is been extended from Animal(parent class)
	    void meow() {
	    	System.out.println("Cat meow");
	    }
  }
